    {
      "name": "2. POST /api/jokes",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Állapotkód 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Van Location fejléc', function () {",
              "    pm.response.to.have.header('Location');",
              "});",
              "pm.test('A válasz tartalmazza a message és data.id mezőket', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('message').that.is.a('string');",
              "    pm.expect(jsonData).to.have.property('data').that.is.an('object');",
              "    pm.expect(jsonData.data).to.have.property('id').that.is.a('number');",
              "    pm.expect(jsonData.data.type).to.eql('single');",
              "    pm.expect(jsonData.data.joke).to.eql('Miért nem szeretnek a programozók a természetben sétálni? Túl sok a bug.');",
              "    pm.expect(jsonData.data.setup).to.be.null;",
              "    pm.expect(jsonData.data.delivery).to.be.null;",
              "    pm.collectionVariables.set('jokeId', jsonData.data.id);",
              "});"
            ]
          }
        }
      ],
